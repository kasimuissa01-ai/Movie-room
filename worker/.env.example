# Cloudflare Worker Secrets (.env template)
# IMPORTANT: Run `npx wrangler secret put <NAME>` to set these in production.
# NEVER commit real secret values to Git!

# TMDB API Key (v3 32-char key or v4 Bearer token)
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# JWT Secret for signing and verifying mobile client session tokens
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_256BIT_HEX

# Admin API Key or Passcode for administrative endpoints
ADMIN_API_KEY=admin2026

# Optional Database & Storage Bindings
DATABASE_URL=https://your-db-url.com
DATABASE_SERVICE_KEY=YOUR_DATABASE_SERVICE_KEY
R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_R2_SECRET_KEY
