# ====================================================================
# CineStream Mobile Client Configuration (.env.example)
#
# SECURITY MANDATE:
# NO private API keys, database credentials, Cloudflare R2 secret tokens,
# or service-role keys are ever included in the mobile application.
# All requests are securely proxied through our Cloudflare Worker backend.
# ====================================================================

# Cloudflare Worker Backend API (Default: https://movie-api.grapherkidd0.workers.dev)
API_BASE_URL=https://movie-api.grapherkidd0.workers.dev

# Public Media CDN / Stream base (Optional - fallback streaming domain)
R2_PUBLIC_URL_BASE=https://pub-r2.dev

# Admin Mode Passcode (Verified server-side via Worker JWT Auth)
ADMIN_PASSCODE=admin2026
