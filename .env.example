# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TMDB_API_KEY: Required for The Movie Database (TMDB) API calls.
# Injected securely via the Secrets panel in AI Studio.
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# Cloudflare R2 Storage configuration
# R2_ACCOUNT_ID: Cloudflare 32-character Account ID (e.g., from Cloudflare Dashboard URL or R2 overview)
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID

# R2_ACCESS_KEY_ID: S3-compatible R2 API token Access Key ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID

# R2_SECRET_ACCESS_KEY: S3-compatible R2 API token Secret Access Key
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# R2_BUCKET_NAME: The name of the R2 bucket where movies and posters are stored
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME

# R2_PUBLIC_URL_BASE: Public custom domain or R2.dev public URL (e.g., https://pub-xxx.r2.dev or https://media.yourdomain.com)
R2_PUBLIC_URL_BASE=https://pub-r2.dev

# ADMIN_PASSCODE: Passcode required to unlock Admin Mode and access the Movie Upload panel
ADMIN_PASSCODE=admin2026

